{
	"name": "@animateicons/angular",
	"version": "0.1.0",
	"description": "Animated SVG icons for Angular. One standalone component with signal inputs, server rendering and zoneless support, with the same motion as @animateicons/react.",
	"license": "MIT",
	"author": "Avijit Dey",
	"homepage": "https://animateicons.in",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Avijit07x/animateicons.git",
		"directory": "angular"
	},
	"bugs": {
		"url": "https://github.com/Avijit07x/animateicons/issues"
	},
	"keywords": [
		"icons",
		"animated icons",
		"animated svg",
		"angular icons",
		"angular",
		"standalone component",
		"motion icons",
		"svg icons",
		"lucide animated",
		"huge animated",
		"free animated icons"
	],
	"sideEffects": false,
	"scripts": {
		"build": "ng-packagr -p ng-package.json -c tsconfig.json && node scripts/finalize-dist.mjs",
		"test": "vitest run",
		"typecheck": "tsc -p __tests__/tsconfig.json",
		"size": "size-limit",
		"verify": "pnpm run build && pnpm run typecheck && pnpm run test && pnpm run size"
	},
	"size-limit": [
		{
			"name": "component + one icon",
			"path": [
				"dist/fesm2022/animateicons-angular.mjs",
				"dist/fesm2022/animateicons-angular-lucide.mjs"
			],
			"import": {
				"dist/fesm2022/animateicons-angular.mjs": "{ AnimateIcons }",
				"dist/fesm2022/animateicons-angular-lucide.mjs": "{ Bell }"
			},
			"limit": "26 kB",
			"ignore": [
				"@angular/core"
			]
		}
	],
	"peerDependencies": {
		"@angular/core": "^20.0.0 || ^21.0.0 || ^22.0.0"
	},
	"dependencies": {
		"@animateicons/vanilla": "workspace:^",
		"tslib": "^2.8.1"
	},
	"devDependencies": {
		"@angular/common": "^22.2.3",
		"@angular/compiler": "^22.2.3",
		"@angular/compiler-cli": "^22.2.3",
		"@angular/core": "^22.2.3",
		"@angular/platform-browser": "^22.2.3",
		"@angular/platform-server": "^22.2.3",
		"@size-limit/preset-small-lib": "^11.1.6",
		"@types/node": "^25.9.9",
		"jsdom": "^30.1.1",
		"ng-packagr": "^22.2.4",
		"rxjs": "^7.8.2",
		"size-limit": "^11.1.6",
		"typescript": "~6.0.3",
		"vitest": "^4.1.10",
		"zone.js": "~0.16.0"
	}
}
