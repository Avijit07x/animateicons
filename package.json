{
	"name": "animateicons-monorepo",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@10.0.0",
	"scripts": {
		"hooks:install": "git config core.hooksPath .githooks",
		"format": "prettier --write .",
		"gen:indices": "tsx scripts/generate-indices.ts",
		"gen:icons-json": "tsx scripts/generate-icons-json.ts",
		"gen:registry": "tsx scripts/generate-registry.ts",
		"gen:catalog": "tsx scripts/generate-catalog.ts",
		"gen:icons": "pnpm run gen:indices && pnpm run gen:icons-json && pnpm run gen:registry && pnpm run gen:catalog",
		"check:icons": "tsx scripts/check-duplicate-icons.ts",
		"check:registry": "tsx scripts/check-registry.ts",
		"check:readme": "tsx scripts/check-readme-counts.ts",
		"check:all": "pnpm run format && pnpm run check:icons && pnpm run check:registry",
		"prebuild": "pnpm run gen:icons && pnpm run check:all",
		"dev": "pnpm run gen:icons && pnpm run check:all && next dev --turbopack",
		"build": "next build",
		"start": "next start",
		"lint": "eslint .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"build:packages": "pnpm --filter @animateicons/core build && pnpm --filter animateicons build && pnpm --filter @animateicons/mcp build",
		"verify:packages": "pnpm --filter @animateicons/core verify && pnpm --filter animateicons verify && pnpm --filter @animateicons/mcp verify",
		"verify": "pnpm run check:all && pnpm run typecheck && pnpm run test && pnpm --filter @animateicons/react verify && pnpm run verify:packages",
		"ship": "pnpm run verify && pnpm run build",
		"changeset": "changeset",
		"changeset:version": "changeset version",
		"release:npm:patch": "pnpm --filter @animateicons/react release:patch && git push --follow-tags",
		"release:npm:minor": "pnpm --filter @animateicons/react release:minor && git push --follow-tags",
		"release:npm:major": "pnpm --filter @animateicons/react release:major && git push --follow-tags",
		"knip": "knip",
		"lint:package": "pnpm --filter @animateicons/react build && publint npm && attw --pack npm --profile node16",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@mdx-js/loader": "^3.1.1",
		"@mdx-js/react": "^3.1.1",
		"@microsoft/clarity": "^1.0.2",
		"@next/mdx": "^16.3.7",
		"@radix-ui/react-separator": "^1.1.15",
		"@types/mdx": "^2.0.14",
		"@vercel/analytics": "^2.0.1",
		"babel-plugin-react-compiler": "^1.0.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.4.0",
		"fuse.js": "^7.5.0",
		"lucide-react": "^1.48.0",
		"motion": "^13.4.4",
		"next": "^16.3.7",
		"radix-ui": "^1.6.7",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"shiki": "^4.4.3",
		"tailwind-merge": "^3.7.0",
		"use-debounce": "^10.1.1"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@changesets/cli": "^2.31.1",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@tailwindcss/postcss": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^26.6.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^5.2.0",
		"@vitest/coverage-v8": "4.1.11",
		"baseline-browser-mapping": "^2.11.26",
		"eslint": "^9.39.5",
		"eslint-config-next": "^16.3.7",
		"jsdom": "^30.1.1",
		"knip": "^6.38.0",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.9",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"publint": "^0.3.24",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.11"
	},
	"pnpm": {
		"overrides": {
			"picomatch@^4": "4.0.7"
		}
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx,mjs,cjs}": [
			"prettier --write",
			"eslint --fix"
		],
		"*.{json,md,mdx,css,yml,yaml}": "prettier --write"
	}
}
