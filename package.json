{
	"name": "animateicons-monorepo",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@12.8.1",
	"scripts": {
		"dev": "pnpm gen:icons && pnpm format && pnpm check && next dev --turbopack",
		"prebuild": "pnpm gen:icons && pnpm check",
		"build": "next build",
		"start": "next start",
		"analyze": "next experimental-analyze",
		"gen:icons": "tsx scripts/generate-indices.ts && tsx scripts/generate-icons-json.ts && tsx scripts/generate-registry.ts && tsx scripts/generate-catalog.ts && tsx scripts/generate-docs.ts && tsx scripts/generate-icon-data.ts",
		"gen:docs": "tsx scripts/generate-docs.ts",
		"format": "prettier --write .",
		"lint": "eslint .",
		"typecheck": "tsc --noEmit",
		"knip": "knip",
		"check": "tsx scripts/check-duplicate-icons.ts && tsx scripts/check-registry.ts && tsx scripts/check-readme-counts.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"build:packages": "pnpm -r run build",
		"verify:packages": "pnpm -r run verify",
		"lint:packages": "publint npm && attw --pack npm --profile node16 && publint vanilla && attw --pack vanilla --profile esm-only && publint vue && attw --pack vue --profile esm-only",
		"verify": "pnpm format && pnpm check && pnpm typecheck && pnpm test && pnpm verify:packages",
		"ship": "pnpm verify && pnpm build",
		"release:npm:patch": "pnpm --filter @animateicons/react release:patch && git push --follow-tags",
		"release:npm:minor": "pnpm --filter @animateicons/react release:minor && git push --follow-tags",
		"release:npm:major": "pnpm --filter @animateicons/react release:major && git push --follow-tags",
		"hooks:install": "git config core.hooksPath .githooks"
	},
	"dependencies": {
		"@animateicons/core": "workspace:*",
		"@mdx-js/loader": "^3.1.1",
		"@mdx-js/react": "^3.1.1",
		"@microsoft/clarity": "^1.0.2",
		"@next/mdx": "^16.3.7",
		"@radix-ui/react-separator": "^1.1.15",
		"@types/mdx": "^2.0.14",
		"@vercel/analytics": "^2.0.1",
		"babel-plugin-react-compiler": "^1.0.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.4.0",
		"lucide-react": "^1.48.0",
		"motion": "^14.3.0",
		"next": "^16.3.7",
		"radix-ui": "^1.6.7",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"shiki": "^4.4.3",
		"tailwind-merge": "^3.7.0",
		"use-debounce": "^10.1.1"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@tailwindcss/postcss": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^26.2.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^5.2.0",
		"@vitest/coverage-v8": "4.1.10",
		"axe-core": "^4.13.0",
		"baseline-browser-mapping": "^2.11.26",
		"esbuild": "^0.28.1",
		"eslint": "^9.39.5",
		"eslint-config-next": "^16.3.7",
		"jsdom": "^30.1.1",
		"knip": "^6.38.0",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.9",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"publint": "^0.3.24",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.10"
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx,mjs,cjs}": [
			"prettier --write",
			"eslint --fix"
		],
		"*.{json,md,mdx,css,yml,yaml}": "prettier --write"
	}
}
