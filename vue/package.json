{
	"name": "@animateicons/vue",
	"version": "0.1.0",
	"description": "Animated SVG icons for Vue 3 and Nuxt. The same motion as @animateicons/react, with server rendering and typed refs.",
	"license": "MIT",
	"author": "Avijit Dey",
	"homepage": "https://animateicons.in",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Avijit07x/animateicons.git",
		"directory": "vue"
	},
	"bugs": {
		"url": "https://github.com/Avijit07x/animateicons/issues"
	},
	"keywords": [
		"icons",
		"animated icons",
		"animated svg",
		"vue icons",
		"vue 3",
		"nuxt icons",
		"motion icons",
		"svg icons",
		"lucide animated",
		"huge animated",
		"free animated icons"
	],
	"type": "module",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./lucide": {
			"types": "./dist/lucide.d.ts",
			"default": "./dist/lucide.js"
		},
		"./lucide/*": {
			"types": "./dist/lucide/*.d.ts",
			"default": "./dist/lucide/*.js"
		},
		"./huge": {
			"types": "./dist/huge.d.ts",
			"default": "./dist/huge.js"
		},
		"./huge/*": {
			"types": "./dist/huge/*.d.ts",
			"default": "./dist/huge/*.js"
		},
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"files": [
		"dist",
		"CHANGELOG.md",
		"README.md",
		"LICENSE",
		"THIRD_PARTY_NOTICES.md"
	],
	"engines": {
		"node": ">=18.17.0"
	},
	"scripts": {
		"gen": "node scripts/generate-icons.mjs",
		"build": "pnpm run gen && tsup && node scripts/generate-icon-dts.mjs",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"size": "size-limit",
		"verify": "pnpm run build && pnpm run typecheck && pnpm run test && pnpm run size",
		"prepack": "pnpm run verify"
	},
	"size-limit": [
		{
			"name": "one icon component",
			"path": "dist/lucide.js",
			"import": "{ BellIcon }",
			"limit": "25.5 kB",
			"ignore": [
				"vue"
			]
		},
		{
			"name": "five icon components",
			"path": "dist/lucide.js",
			"import": "{ BellIcon, BellRingIcon, HeartIcon, CopyIcon, ActivityIcon }",
			"limit": "26 kB",
			"ignore": [
				"vue"
			]
		}
	],
	"peerDependencies": {
		"vue": "^3.5.0"
	},
	"dependencies": {
		"@animateicons/vanilla": "workspace:^"
	},
	"devDependencies": {
		"@size-limit/preset-small-lib": "^11.1.6",
		"@types/node": "^25.9.1",
		"jsdom": "^30.1.1",
		"size-limit": "^11.1.6",
		"tsup": "^8.3.0",
		"typescript": "^5.9.3",
		"vitest": "^4.1.10",
		"vue": "^3.5.44"
	},
	"publishConfig": {
		"access": "public"
	}
}
